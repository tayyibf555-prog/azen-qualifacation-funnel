# ─── Booking ─────────────────────────────────────────────────────────────────
# Your Calendly event link, e.g. https://calendly.com/azen/discovery-call
NEXT_PUBLIC_CALENDLY_URL=

# ─── Google Sheet backup (the safety net) ────────────────────────────────────
# Apps Script web app URL. See README → "Google Sheet backup".
SHEETS_WEBHOOK_URL=
# Must match SHARED_SECRET in google-apps-script/Code.gs
SHEETS_SHARED_SECRET=

# ─── Lead delivery ───────────────────────────────────────────────────────────
# Anything that accepts a POST: Make, n8n, Zapier, a Slack webhook, your CRM.
LEAD_WEBHOOK_URL=
# Which stages reach it. Default is finished leads only; add partial and
# abandoned if you want to trigger an abandonment sequence.
LEAD_WEBHOOK_STAGES=complete,booked

# Email per completed lead. All three needed, or email is skipped.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=you@azen.io
LEAD_FROM_EMAIL=funnel@azen.io

# ─── Ad tracking ─────────────────────────────────────────────────────────────
# Browser pixel.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# Server-side Conversions API. Survives ad blockers and iOS; deduplicated
# against the browser pixel by event id. Needs the pixel id above.
META_CAPI_TOKEN=
# Set only while testing in Events Manager, then remove.
META_TEST_EVENT_CODE=
